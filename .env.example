# ==========================================
# ProofSkill AI — Environment Configuration
# ==========================================
# Copy this file to .env for local development.
# Never commit .env or real credentials to Git.
# Keep optional integrations disabled until configured.

# ------------------------------------------
# Application
# ------------------------------------------
APP_NAME=ProofSkill AI
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8501
DEBUG=false
LOG_LEVEL=INFO
DEMO_MODE=true

# ------------------------------------------
# Database
# ------------------------------------------
# SQLite is suitable for the initial local demo.
DATABASE_URL=sqlite:///data/proofskill.db

# ------------------------------------------
# AI Provider
# ------------------------------------------
# Supported provider names depend on the application implementation.
# Keep the provider unset until a supported integration is configured.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# ------------------------------------------
# Embeddings and Semantic Matching
# ------------------------------------------
# Example model: sentence-transformers/all-MiniLM-L6-v2
# The application must explicitly load and support the selected model.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# ------------------------------------------
# Resume Processing
# ------------------------------------------
MAX_RESUME_SIZE_MB=10
RESUME_TEXT_MIN_LENGTH=20
RESUME_ALLOWED_EXTENSIONS=pdf,docx,txt

# ------------------------------------------
# GitHub Integration
# ------------------------------------------
# Optional. Use only with appropriate candidate consent.
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_REQUEST_TIMEOUT_SECONDS=15

# ------------------------------------------
# Interview and Assessment
# ------------------------------------------
DEFAULT_INTERVIEW_QUESTIONS=8
DEFAULT_INTERVIEW_DURATION_MINUTES=20
DEFAULT_VIVA_QUESTIONS=10
DEFAULT_VIVA_DURATION_MINUTES=20
MIN_ASSESSMENT_SCORE=0
# Raw question rubric range; normalized performance scores use 0–100.
MAX_ASSESSMENT_SCORE=4

# ------------------------------------------
# Privacy and Security
# ------------------------------------------
# Enable only when the corresponding controls are implemented.
ENABLE_AUDIT_LOGGING=true
STORE_RAW_RESUME=false
STORE_RAW_AUDIO=false
REQUIRE_REPOSITORY_CONSENT=true
REQUIRE_HUMAN_REVIEW=true

# ------------------------------------------
# Optional Speech Processing
# ------------------------------------------
# Keep disabled until a supported transcription integration exists.
ENABLE_SPEECH_TRANSCRIPTION=false
SPEECH_MODEL=

# ------------------------------------------
# Testing
# ------------------------------------------
PYTEST_ADDOPTS=-ra
