# ProofSkill AI — Environment Configuration
# Copy to .env and fill in your values

# ============================================================
# APP SETTINGS
# ============================================================
APP_NAME=ProofSkill AI
DEBUG=true
SECRET_KEY=generate-a-random-32-char-string-here
RECRUITER_ID=admin
RECRUITER_PASSWORD=password
CANDIDATE_DEFAULT_PASSWORD=password

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=sqlite:///data/proofskill.db

# ============================================================
# GITHUB API
# ============================================================
# Personal Access Token with 'public_repo' scope
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_github_pat_here
GITHUB_API_BASE=https://api.github.com
GITHUB_RATE_LIMIT=5000

# ============================================================
# ELEVENLABS TTS
# ============================================================
# Get API key at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=sk_your_elevenlabs_key_here
# Voice IDs: https://elevenlabs.io/docs/api-reference/text-to-speech
# Rachel (default): 21m00Tcm4TlvDq8ikWAM
# Antoni: ErXwobaYiN019PkySvjV
# Domi: AZnzlk1XvdvUeBnXmlld
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ============================================================
# WHISPER STT
# ============================================================
# Models: tiny, base, small, medium, large-v3
# Device: cuda (recommended), cpu, mps
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
# Your Colab/ngrok Whisper API endpoint
WHISPER_API_URL=https://unhelpful-corny-jumbo.ngrok-free.dev/transcribe
WHISPER_API_TIMEOUT=120

# ============================================================
# GRADIO TTS (Your Audio8-TTS Model)
# ============================================================
# Your Hugging Face Space / Gradio endpoint
GRADIO_TTS_URL=https://bd512e52f4484d878a.gradio.live/
GRADIO_TTS_API_NAME=/predict
GRADIO_TTS_TIMEOUT=120

# ============================================================
# FINE-TUNED MODEL
# ============================================================
# Path to model directory (GGUF, ONNX, or HF format)
MODEL_BACKEND=auto
MODEL_API_URL=
MODEL_API_KEY=
MODEL_API_TIMEOUT=300
MODEL_GENERATION_MAX_TOKENS=1024
MODEL_PATH=models/fine_tuned/
# Device: cuda, cpu, mps
MODEL_DEVICE=cuda
# Context window (tokens)
MODEL_MAX_LENGTH=4096
# GPU layers (-1 = all)
MODEL_N_GPU_LAYERS=-1
# Batch size
MODEL_N_BATCH=512

# ============================================================
# IMATS SANDBOX
# ============================================================
IMATS_API_URL=https://sandbox.imats.example.com
IMATS_API_KEY=imatssk_your_key_here

# ============================================================
# FILE PATHS
# ============================================================
RESUME_DIR=data/resumes
REPO_CACHE_DIR=data/repo_cache
EXPORT_DIR=data/exports

# ============================================================
# FAIRNESS
# ============================================================
# Protected attributes that must NEVER influence ranking
PROTECTED_ATTRIBUTES=college,gender,age,location

# ============================================================
# SCORING WEIGHTS (sum = 1.0)
# ============================================================
WEIGHT_EVIDENCE_STRENGTH=0.35
WEIGHT_VIVA_PERFORMANCE=0.35
WEIGHT_ASSESSMENT=0.20
WEIGHT_CONSISTENCY=0.10

# No-GitHub candidate weights
NO_GITHUB_WEIGHT_EVIDENCE_STRENGTH=0.20
NO_GITHUB_WEIGHT_VIVA_PERFORMANCE=0.50
NO_GITHUB_WEIGHT_ASSESSMENT=0.25
NO_GITHUB_WEIGHT_CONSISTENCY=0.05

# ============================================================
# VIVA SETTINGS
# ============================================================
VIVA_MAX_QUESTIONS=10
VIVA_ANSWER_TIMEOUT_SECONDS=60
VIVA_INTRO_DURATION_SECONDS=30

# ============================================================
# REPO ANALYSIS
# ============================================================
MAX_REPO_SIZE_MB=500
MAX_FILE_SIZE_MB=1
ANALYSIS_TIMEOUT_SECONDS=300
TUTORIAL_CLONE_THRESHOLD=0.6

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=INFO
LOG_FILE=logs/proofskill.log